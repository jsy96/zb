# 复制本文件为 env.local，填入自己的 Key 后启动（cp env.example env.local）
# env.local 已被 .gitignore / .vercelignore 排除，不会进仓库、不会部署上传
# 改完 env.local 需重启服务（node server.js）才生效

# ===== 密钥 =====
# 智谱开放平台 https://open.bigmodel.cn （glm-4.5-flash 整理免费；glm-asr 转写按量计费）
zhipu_apikey=

# 硅基流动 https://siliconflow.cn （SenseVoiceSmall 转写免费、小模型免费）
siliconflow_apikey=

# 两家都填 = 全免费组合（整理走智谱，转写走硅基流动）；只填一家就全走那家

# ===== 行为参数（可选，删掉或留空用默认值）=====
# 文稿稳定几秒后自动交给 AI 整理（默认 8）
auto_delay=8
# 录音中每隔几秒整理一次，0 = 关（默认 30）
auto_interval=30
